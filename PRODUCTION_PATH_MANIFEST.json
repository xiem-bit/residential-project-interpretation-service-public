{
  "schema": "residential.production_path_manifest.v0.2",
  "candidate_version": "v0.2.0-rc.1",
  "status": "candidate_incremental_research_and_cross_package_conformance_implemented_gold_reference_migration_pending",
  "semantic_core_role": "required_production_output_not_bootstrap_input",
  "entrypoints": {
    "human_or_agent": "START_HERE.md",
    "rules": "AGENT_RULES.md",
    "workflow": "workflows/residential-production-orchestrator/SKILL.md",
    "machine_verifier": "scripts/verify_production_run.py"
  },
  "stages": [
    {
      "id": "S0",
      "name": "rules_and_task_mode",
      "inputs": ["repository", "authorized_raw_inputs"],
      "outputs": ["project-contract.md"],
      "gate": "rules_loaded"
    },
    {
      "id": "S1",
      "name": "project_identity_and_input_governance",
      "inputs": ["project-contract.md", "authorized_raw_inputs"],
      "outputs": ["fact-conflict-gap-register.json"],
      "gate": "project_identity_closed"
    },
    {
      "id": "S1R",
      "name": "external_research_and_evidence_adoption",
      "condition": "material_judgment_gap_requires_external_owner",
      "inputs": ["project-contract.md", "fact-conflict-gap-register.json", "authorized_research_scope"],
      "outputs": ["residential.upstream_task.v0.2", "public_evidence_envelope.v1", "residential.upstream_response.v0.2", "residential.upstream_adoption_receipt.v0.2"],
      "gate": "evidence_accepted_rejected_or_gap_preserved",
      "return_to": ["authorized_incremental_batch", "input_freeze", "business_gap"]
    },
    {
      "id": "S2",
      "name": "product1_competition_study",
      "inputs": ["project-contract.md", "fact-conflict-gap-register.json", "authorized_raw_inputs"],
      "outputs": ["product1-competition-study.md"],
      "gate": "product1_complete",
      "return_to": ["upstream_task", "competition_boundary_adjustment", "expert_reasoning"]
    },
    {
      "id": "S3",
      "name": "product2_buyer_decision_study",
      "condition": "product2_enabled",
      "inputs": ["product1-competition-study.md", "authorized_customer_inputs"],
      "outputs": ["product2-buyer-decision-study.md"],
      "gate": "product2_complete"
    },
    {
      "id": "S4",
      "name": "unified_semantic_core",
      "inputs": ["project-contract.md", "product1-competition-study.md", "enabled_upstream_products"],
      "outputs": ["semantic-core.json"],
      "gate": "semantic_core_frozen"
    },
    {
      "id": "S5",
      "name": "super_competitiveness_and_production_planning",
      "inputs": ["semantic-core.json", "fact-conflict-gap-register.json"],
      "outputs": ["super-competitiveness-plan.json"],
      "gate": "minimum_three_sc_pass",
      "checks_per_sc": ["purchase_impact", "bounded_unique_or_best", "enemy_relation", "project_support", "ue_provability"],
      "causal_chain_per_sc": ["project_fact", "relative_competition", "customer_importance", "project_response", "ue_proof", "target_action"],
      "inference_relationships": "contracts/inference-relationships.json"
    },
    {
      "id": "S6",
      "name": "product_enablement_and_high_cost_admission",
      "inputs": ["semantic-core.json", "super-competitiveness-plan.json"],
      "outputs": ["product-enablement-matrix.json"],
      "gate": "high_cost_production_admitted_or_research_only"
    },
    {
      "id": "S7",
      "name": "product3_strategy_to_ue",
      "condition": "product3_enabled",
      "inputs": ["semantic-core.json", "super-competitiveness-plan.json"],
      "outputs": ["product3-chapter2-contract.json", "product3-chapter3-contract.json", "ue-solution-handoff.json"],
      "gate": "ue_solution_bridge_pass"
    },
    {
      "id": "S8",
      "name": "product4_or_product5_projection",
      "condition": "product4_or_product5_enabled",
      "inputs": ["semantic-core.json", "super-competitiveness-plan.json", "enabled_upstream_products"],
      "outputs": ["enabled_product4_or_product5_files"],
      "gate": "enabled_branch_contract_pass"
    },
    {
      "id": "S9",
      "name": "change_control_and_reprojection",
      "condition": "material_semantic_change_occurred",
      "inputs": ["new_fact_or_decision", "current_semantic_version"],
      "outputs": ["change-impact-registry.json", "updated_affected_outputs"],
      "gate": "cross_product_consistency_pass"
    }
  ],
  "base_required_run_files": [
    "project-contract.md",
    "fact-conflict-gap-register.json",
    "product1-competition-study.md",
    "semantic-core.json",
    "super-competitiveness-plan.json",
    "product-enablement-matrix.json",
    "production-receipt.json"
  ],
  "conditional_product_files": {
    "2": ["product2-buyer-decision-study.md"],
    "3": ["product3-chapter2-contract.json", "product3-chapter3-contract.json", "ue-solution-handoff.json"],
    "4": ["product4-value-framework-contract.json"],
    "5": ["product5-interaction-blueprint.json"]
  },
  "optional_process_files": {
    "material_semantic_change": ["change-impact-registry.json"]
  },
  "disabled_product_file_policy": "must_be_absent",
  "base_business_status_order": [
    "rules_loaded",
    "project_identity_closed",
    "product1_complete",
    "semantic_core_frozen",
    "minimum_three_sc_pass",
    "cross_product_consistency_pass"
  ],
  "conditional_business_statuses": {
    "2": "product2_complete",
    "3": "ue_solution_bridge_pass",
    "4": "product4_contract_pass",
    "5": "product5_blueprint_pass"
  },
  "adapter_status_namespace": "adapter_statuses",
  "adapter_pass_cannot_satisfy_business_gate": true,
  "machine_validation_scope": "enabled_files_structure_references_states_and_veto_rules_only",
  "machine_pass_cannot_claim": ["strategic_quality", "human_business_accepted", "published", "adopted", "business_effect_observed"],
  "external_research_contract": {
    "request": "external-capabilities/upstream-task.schema.json",
    "upstream_envelope": "public_evidence_envelope.v1",
    "response": "external-capabilities/upstream-response.schema.json",
    "adoption": "external-capabilities/upstream-adoption-receipt.schema.json",
    "compatibility": "external-capabilities/cross-package-compatibility.json",
    "validator": "tools/production_core/validate_upstream_exchange.py",
    "fulfilled_equals_accepted": false
  },
  "release_acceptance": {
    "scope": "package_level_not_per_project_blind_training",
    "protocol": "V0_2_RELEASE_SCOPE.md",
    "private_holdout_included": false,
    "fresh_install_full_public_safe_project_required": true,
    "human_acceptance_required": true
  }
}
