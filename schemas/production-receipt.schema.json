{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/residential/production-receipt.schema.json",
  "type": "object",
  "required": ["schema", "project_id", "run_mode", "enabled_products", "business_statuses", "machine_validation", "human_review", "adapter_statuses", "gaps", "final_status"],
  "properties": {
    "schema": {"const": "residential.production_receipt.v0.2"},
    "run_mode": {"enum": ["tutorial", "real_project_delivery", "non_research_task"]},
    "enabled_products": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [1, 2, 3, 5]}
    },
    "business_statuses": {
      "type": "object",
      "additionalProperties": {"enum": ["pass", "pending", "blocked", "not_run"]}
    },
    "final_status": {"enum": ["machine_validation_pending", "tutorial_reference_complete", "machine_contract_pass", "business_review_pending", "human_business_accepted", "returned_for_research", "blocked"]}
  }
}
