{
  "schema": "residential.public_capability_routing.v0.2",
  "status": "v0.2_candidate",
  "routes": [
    {
      "capability": "residential_business_production_from_raw_inputs",
      "owner": "public_business_orchestrator",
      "entrypoint": "workflows/residential-production-orchestrator/SKILL.md",
      "verification": "python3 scripts/verify_production_run.py RUN_DIR",
      "strategic_quality": "professional_semantic_review_and_task_appropriate_human_acceptance",
      "fallback": "return_to_research_or_emit_structured_gap"
    },
    {
      "capability": "authorized_upstream_evidence",
      "owner": "selected_external_owner",
      "task_schema": "external-capabilities/upstream-task.schema.json",
      "evidence_schema": "public_evidence_envelope.v1",
      "response_schema": "external-capabilities/upstream-response.schema.json",
      "adoption_schema": "external-capabilities/upstream-adoption-receipt.schema.json",
      "compatibility_contract": "external-capabilities/cross-package-compatibility.json",
      "verification": "python3 tools/production_core/validate_upstream_exchange.py --request REQUEST --envelope ENVELOPE --response RESPONSE --adoption ADOPTION",
      "fulfilled_equals_accepted": false,
      "may_adjudicate_competitors_or_sc": false,
      "fallback": "return_partial_gap_or_stopped"
    },
    {
      "capability": "formal_presentation_generation",
      "owner": "carrier_adapter",
      "input_schema": "contracts/presentation_request.schema.json",
      "output_schema": "contracts/presentation_response.schema.json",
      "can_satisfy_business_acceptance": false,
      "fallback": "return_presentation_adapter_gap"
    },
    {
      "capability": "product5_implementation",
      "owner": "carrier_adapter",
      "business_input": "product5-interaction-blueprint.json",
      "can_satisfy_business_acceptance": false,
      "fallback": "return_web_adapter_gap"
    },
    {
      "capability": "business_machine_contract_validation",
      "owner": "public_core",
      "entrypoint": "scripts/verify_production_run.py",
      "scope": "structure_references_states_only",
      "cannot_claim": "strategic_quality_or_human_business_accepted"
    },
    {
      "capability": "release_package_acceptance",
      "owner": "release_maintainer_and_human_acceptance_owner",
      "protocol": "V0_2_RELEASE_SCOPE.md",
      "visual_carrier_required": false,
      "fallback": "fix_release_package_and_repeat_clean_install_acceptance"
    }
  ]
}
